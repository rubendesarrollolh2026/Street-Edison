const URL_SHEETS="https://script.google.com/macros/s/AKfycbyYJRSPi63eYaSiY_cneoEjmY2pedGCwsxmkuOWpDhUqIWTdoZzQ1DrgAh3muoI0s0SAg/exec";


function enviarSheets(datos){

fetch(

URL_SHEETS,

{

method:"POST",

body:JSON.stringify(
datos
),

mode:"no-cors"

}

)

.then(()=>{

console.log(
"Sheets OK"
);

})

.catch(error=>{

console.log(
error
);

});

}



/* RECUPERAR ET DESDE SHEETS */

function cargarETdesdeSheets(){

fetch(

URL_SHEETS+
"?tipo=et"

)

.then(
r=>r.json()
)

.then(
datos=>{

console.log(
"ET cargadas:",
datos
);

if(
!datos ||
datos.length===0
){

return;

}


let listaET=[];


datos.forEach(

et=>{

listaET.push({

nombre:
et.nombre,

latitud:
parseFloat(
et.lat
),

longitud:
parseFloat(
et.lon
),

calle:
et.calle,

hora:
et.fecha

});

}

);


localStorage.setItem(

"ETs",

JSON.stringify(
listaET)

);


if(
typeof mostrarETs==="function"
){

mostrarETs();

}


if(
typeof mostrarETenMapa==="function"
){

mostrarETenMapa();

}

}

)

.catch(

error=>{

console.log(

"Error ET:",

error

);

}

);

}



